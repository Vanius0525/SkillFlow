\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces State transfer weakens before source-attention dependence across eight combinations of model and task. Rows show MedCalc (top) and TheoremQA (bottom), with models aligned by column. Mint: recovery $\rho (L)$ in the wrong-skill receiver. Pink dash-dotted: dependence $d(L)$ in the original correct-skill run. Each panel uses common eligible questions with each protocol's own baselines. $G$ counts skills. Shading spans the first half-effect boundaries (Table\nonbreakingspace \ref {tab:paireddepth}). Later threshold crossings remain visible. Knockout blocks both skill reading and within-skill attention. Every layer is measured.}}{6}{figure.caption.25}\protected@file@percent }
\newlabel{fig:transferreading}{{3}{6}{State transfer weakens before source-attention dependence across eight combinations of model and task. Rows show MedCalc (top) and TheoremQA (bottom), with models aligned by column. Mint: recovery $\rho (L)$ in the wrong-skill receiver. Pink dash-dotted: dependence $d(L)$ in the original correct-skill run. Each panel uses common eligible questions with each protocol's own baselines. $G$ counts skills. Shading spans the first half-effect boundaries (Table~\ref {tab:paireddepth}). Later threshold crossings remain visible. Knockout blocks both skill reading and within-skill attention. Every layer is measured}{figure.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main depth comparison across four open-weight models and two benchmarks. $n/G$ gives common eligible questions/skill groups. $T$ and $R$ are the first half-effect crossings for transfer ($\rho <0.5$) and aggregate source dependence ($d\le 0.5$). $\Delta =R-T$ is in layers. $\Delta /D$ normalizes the gap by the model's layer count. All eight cells use audited common-item populations.}}{6}{table.caption.26}\protected@file@percent }
\newlabel{tab:paireddepth}{{2}{6}{Main depth comparison across four open-weight models and two benchmarks. $n/G$ gives common eligible questions/skill groups. $T$ and $R$ are the first half-effect crossings for transfer ($\rho <0.5$) and aggregate source dependence ($d\le 0.5$). $\Delta =R-T$ is in layers. $\Delta /D$ normalizes the gap by the model's layer count. All eight cells use audited common-item populations}{table.caption.26}{}}
