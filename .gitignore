# python
__pycache__/
*.pyc
.venv/

# agent scratch output (recreated at runtime)
agent_workspace/

# HF download cache inside GAIA
GAIA/.cache/

# run artifacts
logs/
*.log
nul

# eval result files, written to the repo root by the eval entrypoints.
# Anchored to the root so the tracked datasets in AssistantBench/, GAIA/ and
# SciBench/ are untouched.
/skillflow_results_*.jsonl
/skillflow_gaia_*.jsonl
/skillflow_dabstep_*.jsonl
/skillflow_assistantbench_*.jsonl
/scibench_results_*.jsonl
/assistantbench_skills_results_*.jsonl
/gaia_skills_results_*.jsonl
/gaia_results_*.jsonl
/*.submission.jsonl

# run-experiments.sh / experiments-agents.sh write here, one <cell>.jsonl each
/results/

# Where setup-external.sh stages GAIA for inspect_evals. Normally a symlink to
# the tracked GAIA/ tree, a full copy where the filesystem has no symlinks --
# either way it is machine-local and must never be committed.
.inspect_cache/

# smolagents / new runner output written to the repo root
/smolagents_gaia_*.jsonl

# server-local environment setup, deliberately not tracked
env.sh

# local-only claude settings
.claude/settings.local.json

# 白盒实验的产物（每次跑一个 run 目录，和 results/ 同理不进 git）
whitebox/results/
whitebox/tasks/*/tasks.filtered*.jsonl
